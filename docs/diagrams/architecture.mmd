flowchart TB
    subgraph APP["Application layer"]
        direction LR
        Sync[Sync]
        Audio[Audio]
        Chat[Chat]
        Pong[Pong]
        Test[BER Test]
    end
    subgraph XCVR["Transceiver layer"]
        direction LR
        FEC["FEC: CRC, ARQ, XOR"]
        CSMA[CSMA channel access]
        HOP["FHSS hop logic"]
    end
    PHY["Physical layer: RF24 driver and nRF24L01+"]
    TIMER["Hardware timer counter<br/>(+1 every 500 ms)"]
    LOOP["Main loop"]

    APP --> XCVR
    XCVR --> PHY
    TIMER --> HOP
    LOOP -.-> APP
    LOOP -.-> HOP

    style LOOP fill:#eef,stroke:#88a,stroke-dasharray:4 3
    style TIMER fill:#efe,stroke:#6a6
